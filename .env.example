# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal — Payments Standard (classic buttons + IPN). No API keys are needed:
# the buyer is posted to PayPal with a set of form fields, and PayPal notifies
# /api/paypal/ipn of the outcome. Leave PAYPAL_RECEIVER_EMAIL blank to keep
# PayPal switched off — the registration form then offers Telegram instead.
#
# "sandbox" (the default, and anything that isn't exactly "live") uses the
# PayPal sandbox. Only "live" takes real money.
PAYPAL_MODE=sandbox
# The PayPal account address that receives payments. Checked against what
# PayPal reports on every IPN, so it must match the account exactly.
PAYPAL_RECEIVER_EMAIL=

# Public site URL. Used to build the PayPal notify_url and return URL, so it
# must be the address PayPal can actually reach this deployment on.
# Local dev: http://localhost:3000
# Production: https://your-project.vercel.app
# On a Vercel preview, leave this UNSET: the checkout route falls back to the
# request origin, so a sandbox payment notifies the preview and never production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram link shown as a fallback if payment doesn't go through
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_club_bot
