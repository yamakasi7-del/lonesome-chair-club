# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers -> API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal — Developer Dashboard -> Apps & Credentials
# Leave blank to keep PayPal switched off; the card (Stripe) flow is unaffected
# and the PayPal option on the form explains that it's unavailable.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional: set to "production" to charge live PayPal accounts (default: sandbox)
PAYPAL_ENV=

# Public site URL (used for Stripe redirect + webhook links)
# Local dev: http://localhost:3000
# Production: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram link shown as a fallback if payment doesn't go through
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_club_bot
